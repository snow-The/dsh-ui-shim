{
  "name": "@snow-the/dsh-ui-shim",
  "version": "0.1.2",
  "description": "Standalone three-column shim for DeepSeek Harness web: stamps data-pane/data-dsh-frame on the layout so plugins can target sidebar/conversation/details without depending on official DOM class names.",
  "type": "module",
  "main": "./client.js",
  "exports": {
    ".": "./client.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "shim",
    "ui",
    "deepseek-harness"
  ],
  "files": [
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snow-The/dsh-ui-shim.git"
  }
}