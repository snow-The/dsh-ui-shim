{
  "name": "@snow-the/dsh-ui-shim",
  "version": "0.1.9",
  "description": "Standalone three-column shim for DeepSeek Harness web: stamps data-pane/data-dsh-frame on the layout so plugins can target sidebar/conversation/details without depending on official DOM class names.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "shim",
    "ui",
    "deepseek-harness"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    },
    "compatibility": {
      "dshReleases": [
        "0.2.0-rc.1",
        "0.2.0-rc.2"
      ],
      "verifiedAgainst": "0.2.0-rc.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snow-The/dsh-ui-shim.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  }
}
